#!/bin/bash
# Privileged operations for CPU Power — only whitelisted commands.
set -euo pipefail

AUTO_CPUFREQ="/usr/local/bin/auto-cpufreq"
[[ -x "$AUTO_CPUFREQ" ]] || AUTO_CPUFREQ="/usr/bin/auto-cpufreq"
CONF="/etc/auto-cpufreq.conf"
BAT="/sys/class/power_supply/BAT1/charge_control_end_threshold"

usage() {
  echo "Usage: $0 auto-cpufreq --force=...|--turbo=...|..." >&2
  echo "       $0 set-charge PERCENT" >&2
  echo "       $0 write-config TMPFILE" >&2
  echo "       $0 set-swappiness VALUE" >&2
  echo "       $0 write-zramswap TMPFILE" >&2
  echo "       $0 zramswap-boot enable|disable" >&2
  echo "       $0 samsung-mode MODE" >&2
  echo "       $0 install-daemon" >&2
  echo "       $0 check" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

PROFILE="/sys/firmware/acpi/platform_profile"

set_profile() {
  [[ -f "$PROFILE" ]] || { echo "This laptop has no Samsung performance mode." >&2; exit 1; }
  case "$1" in
    low-power|quiet|balanced|performance) ;;
    *) echo "Rejected platform profile: $1" >&2; exit 1 ;;
  esac
  echo "$1" >"$PROFILE"
}

# Writing performance while it is already selected does not refresh the fan curve.
set_power_profile() {
  [[ -f "$PROFILE" ]] || return 0
  echo balanced >"$PROFILE" || true
  sleep 0.15
  echo performance >"$PROFILE"
}

cpu_floor() {
  local mode="$1"
  local pstate="/sys/devices/system/cpu/intel_pstate"
  local cpu max min target epp
  if [[ "$mode" == high ]]; then
    echo 100 >"$pstate/max_perf_pct" 2>/dev/null || true
    echo 100 >"$pstate/min_perf_pct" 2>/dev/null || true
  else
    echo 100 >"$pstate/max_perf_pct" 2>/dev/null || true
    echo 10 >"$pstate/min_perf_pct" 2>/dev/null || true
  fi
  for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
    [[ -f "$cpu/cpufreq/cpuinfo_max_freq" ]] || continue
    max="$(cat "$cpu/cpufreq/cpuinfo_max_freq")"
    min="$(cat "$cpu/cpufreq/cpuinfo_min_freq")"
    if [[ "$mode" == high ]]; then
      target="$max"
      epp="performance"
    else
      target="$min"
      epp="balance_performance"
    fi
    echo "$max" >"$cpu/cpufreq/scaling_max_freq" 2>/dev/null || true
    echo "$target" >"$cpu/cpufreq/scaling_min_freq" 2>/dev/null || true
    if [[ -f "$cpu/cpufreq/energy_performance_preference" ]]; then
      echo "$epp" >"$cpu/cpufreq/energy_performance_preference" 2>/dev/null || true
    fi
  done
}

samsung_mode_is_power() {
  local f mode
  for f in /home/*/.config/zorin-cpu-power/samsung-mode; do
    [[ -f "$f" ]] || continue
    mode="$(tr -d '[:space:]' <"$f")"
    [[ "$mode" == power ]] && return 0
  done
  return 1
}

# Re-applying --turbo=auto on every profile change makes the daemon flip turbo
# often; only call auto-cpufreq when the pickle differs from what we need.
current_turbo_mode() {
  python3 -c "
import pickle
from pathlib import Path
p = Path('/opt/auto-cpufreq/turbo-override.pickle')
if not p.is_file():
    print('auto')
else:
    try:
        v = pickle.loads(p.read_bytes())
        print(v if v in ('never', 'always') else 'auto')
    except Exception:
        print('auto')
" 2>/dev/null || echo "auto"
}

run_turbo_if_needed() {
  local want="$1"
  local cur
  cur="$(current_turbo_mode)"
  [[ "$cur" == "$want" ]] && return 0
  "$AUTO_CPUFREQ" "--turbo=$want" || true
}

case "$1" in
  auto-cpufreq)
    shift
    [[ $# -ge 1 ]] || usage
    allowed=0
    for arg in "$@"; do
      case "$arg" in
        --force=reset|--force=powersave|--force=performance)
          allowed=1
          ;;
        --turbo=auto|--turbo=never|--turbo=always)
          allowed=1
          ;;
        --install)
          allowed=1
          ;;
        *)
          echo "Rejected argument: $arg" >&2
          exit 1
          ;;
      esac
    done
    [[ "$allowed" -eq 1 ]] || usage
    "$AUTO_CPUFREQ" "$@"
    status=$?
    for arg in "$@"; do
      case "$arg" in
        --turbo=always)
          if samsung_mode_is_power; then
            set_power_profile
            cpu_floor high
          fi
          ;;
        --turbo=auto|--turbo=never)
          cpu_floor normal
          ;;
      esac
    done
    exit "$status"
    ;;
  set-charge)
    [[ $# -eq 2 ]] || usage
    pct="$2"
    [[ "$pct" =~ ^[0-9]+$ ]] || exit 1
    (( pct >= 50 && pct <= 100 )) || exit 1
    [[ -f "$BAT" ]] || { echo "No charge limit control on this device." >&2; exit 1; }
    echo "$pct" >"$BAT"
    ;;
  write-config)
    [[ $# -eq 2 && -f "$2" ]] || usage
    tmp="$2"
    grep -q '^\[charger\]' "$tmp" && grep -q '^\[battery\]' "$tmp" || exit 1
    cp "$tmp" "$CONF"
    systemctl restart auto-cpufreq.service 2>/dev/null || true
    ;;
  set-swappiness)
    [[ $# -eq 2 ]] || usage
    val="$2"
    [[ "$val" =~ ^[0-9]+$ ]] || exit 1
    (( val >= 0 && val <= 200 )) || exit 1
    echo "$val" > /proc/sys/vm/swappiness
    printf 'vm.swappiness=%s\n' "$val" > /etc/sysctl.d/99-zorin-cpu-power-swappiness.conf
    ;;
  write-zramswap)
    [[ $# -eq 2 && -f "$2" ]] || usage
    tmp="$2"
    grep -qE '^ALGO=[a-z0-9_-]+$' "$tmp" || exit 1
    grep -qE '^PERCENT=[0-9]+$' "$tmp" || exit 1
    grep -qE '^PRIORITY=-?[0-9]+$' "$tmp" || exit 1
    cp "$tmp" /etc/default/zramswap
    systemctl restart zramswap.service
    ;;
  zramswap-boot)
    [[ $# -eq 2 ]] || usage
    case "$2" in
      enable)
        systemctl enable zramswap.service
        systemctl start zramswap.service
        ;;
      disable)
        systemctl stop zramswap.service
        systemctl disable zramswap.service
        ;;
      *)
        exit 1
        ;;
    esac
    ;;
  check)
    exit 0
    ;;
  install-daemon)
    managed="/opt/auto-cpufreq/current/share/scripts/auto-cpufreq.service"
    unit="/etc/systemd/system/auto-cpufreq.service"
    # Older installs point ExecStart at /opt/auto-cpufreq/venv, which this
    # package no longer ships. --install refuses to replace that unit, so the
    # service stays failed with "not running in daemon mode".
    if [[ -f "$managed" && -f "$unit" ]]; then
      execstart="$(awk -F= '/^ExecStart=/{print $2; exit}' "$unit" | awk '{print $1}')"
      if [[ -n "$execstart" && ! -x "$execstart" ]]; then
        cp "$managed" "$unit"
      fi
    elif [[ -f "$managed" && ! -e "$unit" ]]; then
      cp "$managed" "$unit"
    fi
    "$AUTO_CPUFREQ" --install || true
    systemctl daemon-reload
    systemctl reset-failed auto-cpufreq.service || true
    systemctl enable auto-cpufreq.service
    systemctl restart auto-cpufreq.service
    systemctl is-active --quiet auto-cpufreq.service
    echo "auto-cpufreq daemon is running."
    ;;
  samsung-mode)
    [[ $# -ge 2 ]] || usage
    [[ -f "$PROFILE" ]] || { echo "This laptop has no Samsung performance mode." >&2; exit 1; }
    case "$2" in
      silent)
        set_profile low-power
        "$AUTO_CPUFREQ" --force=powersave || true
        cpu_floor normal
        ;;
      quiet)
        set_profile quiet
        "$AUTO_CPUFREQ" --force=powersave || true
        cpu_floor normal
        ;;
      balance)
        set_profile balanced
        "$AUTO_CPUFREQ" --force=reset || true
        cpu_floor normal
        ;;
      power)
        set_power_profile
        "$AUTO_CPUFREQ" --force=performance || true
        cpu_floor high
        ;;
      adaptive)
        "$AUTO_CPUFREQ" --force=reset || true
        cpu_floor normal
        ;;
      platform)
        [[ $# -eq 3 ]] || usage
        set_profile "$3"
        ;;
      apply)
        [[ $# -eq 4 ]] || usage
        case "$4" in
          silent)
            set_profile "$3"
            "$AUTO_CPUFREQ" --force=powersave || true
            cpu_floor normal
            ;;
          quiet)
            set_profile "$3"
            "$AUTO_CPUFREQ" --force=powersave || true
            cpu_floor normal
            ;;
          balance)
            set_profile "$3"
            "$AUTO_CPUFREQ" --force=reset || true
            cpu_floor normal
            ;;
          power)
            set_power_profile
            "$AUTO_CPUFREQ" --force=performance || true
            cpu_floor high
            ;;
          cool)
            # Power fan while the CPU is still hot, without pinning the clocks.
            set_power_profile
            "$AUTO_CPUFREQ" --force=reset || true
            cpu_floor normal
            ;;
          *)
            echo "Rejected apply kind: $4" >&2
            exit 1
            ;;
        esac
        ;;
      *)
        echo "Rejected mode: $2" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    usage
    ;;
esac
